# 后端镜像：包含主应用 JAR，插件目录通过挂载注入
FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/eclipse-temurin:21-jre-jammy

WORKDIR /app

# 可选 Python 运行时：Agent 的 Python 工具与工作流代码节点需要解释器。默认不安装以保持镜像精简，
# 未安装时这些工具不会交给模型、系统工具页给出提示；需要时构建传 --build-arg INSTALL_PYTHON=true
ARG INSTALL_PYTHON=false
RUN if [ "$INSTALL_PYTHON" = "true" ]; then \
      apt-get update \
      && apt-get install -y --no-install-recommends python3 python-is-python3 \
      && rm -rf /var/lib/apt/lists/*; \
    fi

# 插件扫描目录与市场源发布物目录必须分开；后者重建镜像后仍需通过挂载保留
RUN mkdir -p /app/plugins /app/market-source

# 复制主应用 JAR（CI 构建产物，spring-boot-maven-plugin 生成的可执行 fat jar）
COPY yudream-bootstrap/target/yudream-bootstrap-*.jar /app/app.jar

# 前端静态壳 index.html：yudream.seo.enabled=true 时供 /api/public/seo/view 做 head 注入
COPY yudream-frontend/apps/core-arco-design-vue/dist/index.html /app/public/index.html

# 插件扫描目录与市场源发布物目录挂载点
VOLUME /app/plugins
VOLUME /app/market-source

EXPOSE 8080

# 生产环境默认使用 plugins/ 作为插件扫描目录；市场源独立存放
ENV YUDREAM_PLATFORM_PLUGIN_DIRECTORIES=/app/plugins
ENV PLATFORM_PLUGIN_MARKET_SOURCE_DIRECTORY=/app/market-source

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
