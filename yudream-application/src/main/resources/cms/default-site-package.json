  "assets": [],
  "features": {
   "content": {
    "sections": [
     {
      "code": "home-hero",
      "title": "首页横幅",
      "description": "首屏标题、介绍、按钮与可选背景图。",
      "fields": [
       {
        "key": "heroTitle",
        "label": "标题",
        "type": "text",
        "defaultValue": "欢迎来到本站"
       },
       {
        "key": "heroText",
        "label": "介绍",
        "type": "textarea",
        "defaultValue": "在这里介绍你的站点：它是做什么的、适合谁、从哪里开始。"
       },
       {
        "key": "heroImage",
        "label": "背景图（可选）",
        "type": "image"
       },
       {
        "key": "primaryText",
        "label": "主按钮文字",
        "type": "text",
        "defaultValue": "开始浏览"
       },
       {
        "key": "primaryLink",
        "label": "主按钮链接",
        "type": "link",
        "defaultValue": "/wiki"
       },
       {
        "key": "secondaryShow",
        "label": "显示次按钮",
        "type": "switch",
        "defaultValue": true
       },
       {
        "key": "secondaryText",
        "label": "次按钮文字",
        "type": "text",
        "defaultValue": "登录"
