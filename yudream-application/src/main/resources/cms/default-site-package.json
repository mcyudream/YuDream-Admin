    }
   ],
   "classes": [
    {
     "name": "site",
     "styles": {
      "min-height": "100vh",
      "display": "flex",
      "flex-direction": "column",
      "background": "var(--bg)",
      "color": "var(--text)",
      "font-family": "var(--font)",
      "line-height": "1.6"
     }
    },
    {
     "name": "wrap",
     "styles": {
      "width": "min(1120px, calc(100% - 40px))",
      "margin": "0 auto"
     },
     "responsive": {
      "mobile": {
       "width": "calc(100% - 32px)"
      }
     }
    },
    {
     "name": "header",
     "styles": {
      "position": "sticky",
      "top": "0",
      "z-index": "10",
      "background": "rgba(255,255,255,.92)",
      "backdrop-filter": "blur(8px)",
      "border-bottom": "1px solid var(--border)"
     }
    },
    {
     "name": "header-inner",
     "styles": {
      "display": "flex",
      "align-items": "center",
      "gap": "24px",
      "height": "64px"
     },
     "responsive": {
      "mobile": {
       "flex-wrap": "wrap",
       "gap": "4px 12px",
       "height": "auto",
       "padding": "10px 0 6px"
      }
     }
    },
    {
     "name": "brand",
     "styles": {
      "display": "flex",
      "align-items": "center",
      "gap": "10px",
      "flex": "none",
      "color": "var(--text)",
      "text-decoration": "none",
      "font-weight": "600",
      "font-size": "17px"
     }
    },
    {
     "name": "brand-logo",
     "styles": {
      "width": "32px",
      "height": "32px",
      "object-fit": "contain",
      "border-radius": "8px"
     }
    },
    {
     "name": "nav",
     "styles": {
      "display": "flex",
      "align-items": "center",
      "gap": "4px",
      "margin": "0",
      "padding": "0",
      "list-style": "none",
      "flex": "1",
      "min-width": "0",
      "overflow-x": "auto"
     },
     "responsive": {
      "mobile": {
       "order": "3",
       "flex-basis": "100%",
       "margin": "0 -8px"
      }
     }
    },
    {
     "name": "nav-link",
     "styles": {
      "display": "block",
      "padding": "8px 12px",
      "border-radius": "8px",
      "color": "var(--muted)",
      "text-decoration": "none",
      "white-space": "nowrap",
      "font-size": "15px"
     },
     "states": {
      "hover": {
       "color": "var(--text)",
       "background": "#f2f3f5"
      },
      "current": {
       "color": "var(--primary)",
       "background": "#eff4ff"
      }
     }
    },
    {
     "name": "account",
     "styles": {
      "flex": "none",
      "display": "flex",
      "align-items": "center",
      "gap": "8px"
     },
     "responsive": {
      "mobile": {
       "margin-left": "auto"
      }
     }
    },
    {
     "name": "btn",
     "styles": {
      "display": "inline-flex",
      "align-items": "center",
      "justify-content": "center",
      "gap": "6px",
      "padding": "10px 18px",
      "border-radius": "10px",
      "background": "var(--primary)",
      "color": "var(--primary-text)",
      "text-decoration": "none",
      "font-size": "15px",
      "font-weight": "500",
      "border": "1px solid var(--primary)"
     },
     "states": {
      "hover": {
       "filter": "brightness(1.08)"
      }
     }
    },
    {
     "name": "btn-ghost",
     "styles": {
      "background": "var(--surface)",
      "color": "var(--text)",
      "border": "1px solid var(--border)"
     },
     "states": {
      "hover": {
       "background": "#f2f3f5"
      }
     }
    },
    {
     "name": "btn-sm",
     "styles": {
      "padding": "6px 14px",
      "font-size": "14px"
     }
    },
    {
     "name": "hero",
     "styles": {
      "padding": "88px 0 72px",
      "background-color": "#eef3ff",
      "background-size": "cover",
      "background-position": "center",
      "border-bottom": "1px solid var(--border)"
     },
     "responsive": {
      "mobile": {
       "padding": "48px 0 40px"
      }
     }
    },
    {
     "name": "hero-title",
     "styles": {
      "margin": "0 0 16px",
      "font-size": "44px",
      "line-height": "1.2",
      "font-weight": "700",
      "letter-spacing": "-.01em"
     },
     "responsive": {
      "mobile": {
       "font-size": "30px"
      }
     }
    },
    {
     "name": "hero-text",
     "styles": {
      "margin": "0 0 28px",
      "max-width": "640px",
      "font-size": "18px",
      "color": "var(--muted)"
     },
     "responsive": {
      "mobile": {
       "font-size": "16px"
      }
     }
    },
    {
     "name": "actions",
     "styles": {
      "display": "flex",
      "flex-wrap": "wrap",
      "gap": "12px"
     }
    },
    {
     "name": "section",
     "styles": {
      "padding": "64px 0"
     },
     "responsive": {
      "mobile": {
       "padding": "40px 0"
      }
     }
    },
    {
     "name": "section-title",
     "styles": {
      "margin": "0 0 8px",
      "font-size": "28px",
      "font-weight": "700"
     },
     "responsive": {
      "mobile": {
       "font-size": "22px"
      }
     }
    },
    {
     "name": "section-text",
     "styles": {
      "margin": "0 0 28px",
      "color": "var(--muted)"
     }
    },
    {
     "name": "grid",
     "styles": {
      "display": "grid",
      "grid-template-columns": "repeat(3, minmax(0, 1fr))",
      "gap": "20px"
     },
     "responsive": {
      "tablet": {
       "grid-template-columns": "repeat(2, minmax(0, 1fr))"
      },
      "mobile": {
       "grid-template-columns": "minmax(0, 1fr)"
      }
     }
    },
    {
     "name": "card",
     "styles": {
      "display": "flex",
      "flex-direction": "column",
      "gap": "10px",
      "padding": "22px",
      "background": "var(--surface)",
      "border": "1px solid var(--border)",
      "border-radius": "var(--radius)",
      "color": "var(--text)",
      "text-decoration": "none",
      "transition": "box-shadow .15s, transform .15s"
     },
     "states": {
      "hover": {
       "box-shadow": "0 8px 24px rgba(15,23,42,.08)",
       "transform": "translateY(-2px)"
      }
     }
    },
    {
     "name": "card-icon",
     "styles": {
      "width": "40px",
      "height": "40px",
      "object-fit": "contain"
     }
    },
    {
     "name": "card-title",
     "styles": {
      "margin": "0",
      "font-size": "18px",
      "font-weight": "600"
     }
    },
    {
     "name": "card-text",
     "styles": {
      "margin": "0",
      "color": "var(--muted)",
      "font-size": "15px"
     }
    },
    {
     "name": "card-meta",
     "styles": {
      "margin-top": "auto",
      "color": "var(--muted)",
      "font-size": "13px"
     }
    },
    {
     "name": "empty",
     "styles": {
      "padding": "32px",
      "text-align": "center",
      "color": "var(--muted)",
      "background": "var(--surface)",
      "border": "1px dashed var(--border)",
      "border-radius": "var(--radius)"
     }
    },
    {
     "name": "footer",
     "styles": {
      "margin-top": "auto",
      "padding": "28px 0",
      "border-top": "1px solid var(--border)",
      "background": "var(--surface)",
      "color": "var(--muted)",
      "font-size": "14px"
     }
    },
    {
     "name": "footer-inner",
     "styles": {
      "display": "flex",
      "flex-wrap": "wrap",
      "justify-content": "space-between",
      "gap": "12px"
     }
    }
   ]
  },
