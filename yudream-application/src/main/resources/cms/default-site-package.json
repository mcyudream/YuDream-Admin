{
 "type": "yudream-site-package",
 "version": 1,
 "kind": "site",
 "document": {
  "schemaVersion": 1,
  "id": "site-default",
  "name": "默认站点",
  "theme": {
   "tokens": {
    "bg": "#f7f8fa",
    "surface": "#ffffff",
    "text": "#1d2129",
    "muted": "#6b7280",
    "border": "#e5e7eb",
    "primary": "#2563eb",
    "primary-text": "#ffffff",
    "radius": "12px",
    "font": "system-ui,-apple-system,\"PingFang SC\",\"Microsoft YaHei\",sans-serif"
   },
   "header": [
    {
