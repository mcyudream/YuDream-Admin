<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- 状态栏常透明（edge-to-edge，页面按 inset 自行预留）；导航栏随 DayNight 页底 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/ydam_system_bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- RNS modal（BottomSheetDialog 独立窗口）同样透明状态栏，避免键盘弹出后顶栏发黑 -->
        <item name="bottomSheetDialogTheme">@style/YdamBottomSheetDialog</item>
    </style>

    <style name="YdamBottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/ydam_system_bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
